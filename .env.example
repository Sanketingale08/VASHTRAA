# ==============================================================================
# VASHTRAA ENVIRONMENT CONFIGURATION EXAMPLE
# ==============================================================================

NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# Database Connections
MONGODB_URI=
MONGODB_DB_NAME=VASTRAA

# Clerk Authentication Keys
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_CLIENT_ID=

# Client-Side Environment Keys
VITE_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_DOMAIN=localhost:5000

# Authentication & Session Secrets (Cryptographically strong min 32 characters)
JWT_SECRET=your_production_jwt_signing_secret_min_32_characters_here
SESSION_SECRET=your_production_session_encryption_secret_min_32_characters_here

# Admin Access
ADMIN_API_KEY=your_secure_admin_api_key_min_32_chars

# Application & Service URLs
FRONTEND_URL=https://vastraasaree.com
BACKEND_URL=https://api.vastraasaree.com

# Centralized Email Notification System (Primary Configuration)
# ------------------------------------------------------------------------------
EMAIL_ENABLED=true
EMAIL_HOST=smtppro.zoho.in
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=support@vastraasaree.com
EMAIL_PASSWORD=your_zoho_app_password_here
EMAIL_FROM_NAME=VASTRAA
EMAIL_FROM_ADDRESS=noreply@vastraasaree.com
EMAIL_REPLY_TO=support@vastraasaree.com

# Zoho SMTP Settings (Production-Ready Nodemailer on Port 465 SSL)
SMTP_HOST=smtppro.zoho.in
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@vastraasaree.com
SMTP_PASSWORD=your_zoho_app_password_here
SMTP_PASS=your_zoho_app_password_here
SMTP_FROM=noreply@vastraasaree.com
SMTP_FROM_NAME=VASTRAA
SMTP_FROM_EMAIL=noreply@vastraasaree.com
SMTP_REPLY_TO=support@vastraasaree.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SUPER_ADMIN_EMAIL=admin@vastraasaree.com

# Cloudflare R2 Storage Configuration (Server-Side Only)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_GLOBAL_API_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_BUCKET_PUBLIC=
R2_BUCKET_PRIVATE=
R2_ENDPOINT=

# Cashfree Payment Gateway & Payouts Configuration (Server-Side Only)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2023-08-01
CASHFREE_PG_WEBHOOK_SECRET=
CASHFREE_PAYOUT_CLIENT_ID=
CASHFREE_PAYOUT_CLIENT_SECRET=
CASHFREE_PAYOUT_ENV=sandbox
CASHFREE_PAYOUT_WEBHOOK_SECRET=
SETTLEMENT_HOLD_DAYS=7
MINIMUM_PAYOUT_THRESHOLD=50000
PAYOUT_MODE=manual
PAYOUT_ENABLED=false

# Shiprocket Integration (Server-Side Only)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
