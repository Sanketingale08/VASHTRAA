{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api-server": {
      "root": "artifacts/api-server",
      "framework": "express",
      "bindings": [
        {
          "type": "service",
          "service": "vastraa",
          "format": "url",
          "env": "FRONTEND_URL"
        }
      ]
    },
    "vastraa": {
      "root": "artifacts/vastraa",
      "framework": "vite",
      "outputDirectory": "dist/public"
    },
    "mockup-sandbox": {
      "root": "artifacts/mockup-sandbox",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api-server"
      }
    },
    {
      "source": "/storage/(.*)",
      "destination": {
        "service": "api-server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "vastraa"
      }
    }
  ]
}

